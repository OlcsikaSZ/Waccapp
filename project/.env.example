# WaccApp - minta környezeti változók
# A fájl célja a szükséges konfigurációs kulcsok bemutatása.
# Valódi token, jelszó, API-kulcs vagy személyes adat ne kerüljön a digitális mellékletbe.

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

DB_PATH=../../03_adatbazis/whatsapp_messages_teszt.db
SESSION_STORE_PATH=./data/sessions.sqlite
SESSION_SECRET=csak_minta_hosszu_random_session_titok
ADMIN_SETUP_TOKEN=csak_minta_owner_setup_token

VERIFY_TOKEN=csak_minta_webhook_verify_token
APP_SECRET=csak_minta_meta_app_secret
ACCESS_TOKEN=csak_minta_meta_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000
PHONE_NUMBER_ID=000000000000000
GRAPH_API_VERSION=v24.0

MEDIA_DIR=public/sent_media
UPLOADS_DIR=public/uploads
MAX_UPLOAD_MB=16

SCHEDULE_TZ=Europe/Budapest
CRON_ENABLED=true
QUESTIONNAIRE_FILE=./questionnaire.js

ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
AUDIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

ALLOW_SELF_SIGNUP=true
DEFAULT_ROLE_ON_SIGNUP=viewer
PRIVACY_VERSION=v1

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=csak_minta_smtp_jelszo
MAIL_FROM="WaccApp Panel" <no-reply@example.com>
ALLOWED_EMAIL_DOMAINS=example.com
